# LLM backend switch: "ollama" | "internal"
LLM_BACKEND=ollama

# Ollama (LLM_BACKEND=ollama 일 때 사용)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma3n:e4b
# 컨텍스트 창(토큰). Ollama 런타임 기본은 4096 이고, 모델이 131k 를 지원해도
# 그 값으로 서빙된다. 넘치면 에러 없이 앞부분이 잘리는데 거기 도구 정의가
# 있으면 모델이 도구를 전혀 못 부른다(빈 응답). 수집 에이전트는 도구 6종
# 스키마만으로 4천 자를 넘긴다. 문서가 크거나 도구가 늘면 더 올린다.
OLLAMA_NUM_CTX=16384

# 사내 OpenAI 호환 API (LLM_BACKEND=internal 일 때 사용; base_url 은 /v1 포함 권장)
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_MODEL=
# 사내 SSL 검사(MITM/사설 CA) 환경:
#  (권장) 사내 루트 CA .pem 경로를 지정하면 검증을 유지한 채 연결됨
INTERNAL_LLM_CA_BUNDLE=
#  (비보안 우회) SSL 검증을 끔(MITM 위험) — 기본값. CA 번들을 구할 수 있으면 위에 지정하고 true 로 바꾸는 걸 권장
INTERNAL_LLM_VERIFY_SSL=false

# 사내 프록시 우회: LLM_BACKEND=internal 이면 자동으로 우회됨(HTTP(S)_PROXY 를 비움).
# ollama 백엔드에서도 프록시를 우회하고 싶을 때만 true 로 설정.
BYPASS_PROXY=false

APP_DB_PATH=./app.db
CORS_ORIGINS=http://localhost:5173

# 개발 실행(dev.py) 백엔드 포트. 8000 이 이미 사용 중일 때만 바꾼다(예: 8001).
# dev.py 와 프론트 vite 프록시가 이 값을 함께 따라가므로 여기만 바꾸면 된다.
BACKEND_PORT=8000

# LLM 디버그 로깅: LLM 호출마다 입력/출력을 사람이 읽기 좋은 텍스트 블록으로 파일에 남긴다.
DEBUG_LOG_ENABLED=true
DEBUG_LOG_PATH=./logs/llm_calls.log
DEBUG_LOG_MAX_BYTES=5000000
DEBUG_LOG_BACKUP_COUNT=5
# 진단용: 콜백 발화/파일 생성/쓰기 과정을 콘솔에 추적 출력(로그가 안 남을 때만 true).
DEBUG_LOG_VERBOSE=false

# ── 금형 데이터 수집 ──────────────────────────────────────────────
# 부서가 엑셀을 올리는 루트(상대경로는 backend/ 기준)
INGEST_ROOT=./data/uploads
# 폴더명:소스종류 쌍. 폴더 이름이 바뀌면 여기만 고친다.
# jig_master(기준정보)가 없으면 관리대장의 설비명을 금형번호로 옮길 수 없고
# MES 조회 키(설비코드)도 못 얻는다 — 금형 식별과 불량율 조인이 동시에 끊긴다.
INGEST_STAGE_DIRS=JIG기준정보:jig_master,EES:ees,MES:mes,IQC:iqc,PQC:pqc,설계:design,설치:install,AI복검:ai_recheck
# 채팅용 app.db 와 반드시 다른 파일이어야 한다(SQLite 쓰기 락 경합 회피)
MOLDS_DB_PATH=./molds.db
MASTER_XLSX_PATH=./data/관리자/금형현황.xlsx
# 0 = 자동 폴링 끔(수동 트리거만)
INGEST_POLL_SECONDS=0

# ── 코팅 초기조건 도출 ──────────────────────────────────────────────
# 원본(raw/)·중간 산출물(interim/)·리포트(reports/) 루트(상대경로는 backend/ 기준)
COATING_DATA_DIR=./data/coating
# 이 분(minute) 안의 제어값 변경들을 하나의 조정 이벤트로 묶는다
COATING_EVENT_MERGE_MINUTES=2
# 안정화 판정: 이동창 길이(분)와 표준편차 상한
COATING_SETTLE_WINDOW_MINUTES=5
COATING_SETTLE_STD_MAX=0.02
# 이 시간 안에 정착을 못 찾으면 오염 이벤트로 버린다
COATING_SETTLE_MAX_WAIT_MINUTES=30
# 튜닝 종료 교차검증 기준(목표±이 값). 스펙 ±0.4 는 이 용도로는 너무 헐겁다.
COATING_TUNING_BAND=0.1
# 영향행렬 커널 반폭 k (파라미터 수 = 2k+1)
COATING_KERNEL_HALF_WIDTH=2
COATING_RIDGE_ALPHA=1.0
# 입력 소스: csv | xlsx | parquet
# 확장자(.csv/.xlsx/.parquet)로 알 수 있으면 그쪽이 이긴다. 이 값은 확장자를
# 모를 때(사내 MES 의 '.dat' 등)의 기본값이다.
#
# 권장 워크플로 — xlsx 는 실행할 때마다 Excel 을 띄우고 xlwings 를 요구한다.
# DRM 이 풀리는 PC 에서 한 번 parquet 으로 바꿔두면 그 뒤로는 둘 다 필요 없다:
#   python -m app.coating.convert --input raw/원본.xlsx --sheet 데이터
#     -> raw/원본.parquet  (실측 4.05s -> 1.36s, 파일 크기 CSV 대비 2%)
#   python -m app.coating.report  --input raw/원본.parquet
COATING_INPUT_FORMAT=csv
# 원본 파일 경로. 상대경로는 COATING_DATA_DIR 기준(raw/ 아래에 둔다).
#   예) 사내 PC: COATING_INPUT_FORMAT=xlsx / COATING_INPUT_PATH=raw/실데이터.xlsx
# 이 값은 '기본값' 일 뿐이다. 파일 이름을 여기 맞춰 바꿀 필요 없이 그때그때
# 인자로 넘긴다 — 어느 파일을 봤는지가 명령에 남는다:
#   python -m app.coating.report --input raw/2026년1월_A라인.csv
#   pytest tests/test_coating_sample_smoke.py --sample raw/2026년1월_A라인.csv
COATING_INPUT_PATH=raw/sample_long.csv
# 읽을 시트 이름. 비우면 첫 시트. xlsx 일 때만 쓴다.
COATING_XLSX_SHEET=
# 원본 CSV 인코딩 후보(앞에서부터 시도). 사내 MES·엑셀 export 는 cp949 가 흔하다.
# utf-8 을 먼저 두는 순서가 중요하다 — cp949 를 먼저 두면 utf-8 한글이 예외 없이
# 깨진 글자로 읽히는 경우가 있다(예: '코팅').
COATING_CSV_ENCODINGS=utf-8-sig,cp949

# ── 동특성(지연) 분석 ──
# 분 단위 패널의 forward-fill 상한. 계단형 값이라 빈 분을 채우는 건 맞지만, 설비가
# 멈춰 관측이 끊긴 구간까지 채우면 있지도 않은 안정 구간이 생겨 노이즈 σ 가 작아진다.
# σ 는 지연 판정 전부의 기준선이라 거기가 기울면 없는 반응을 있다고 말하게 된다.
COATING_PANEL_FFILL_MAX_MINUTES=30
# 이벤트 정렬 창(분). post 가 시정수 τ 보다 충분히 길지 않으면 최종값이 과소평가되고
# τ 도 작게 나온다. 리포트의 '안정 도달' 이 아니오면 post 를 늘린다.
COATING_RESPONSE_PRE_MINUTES=15
COATING_RESPONSE_POST_MINUTES=60
# 라인 속도(m/min). 설비 고정값이고 전 제품에 동일하게 적용된다.
# 판정에는 안 쓴다 - 검산용이다. L x 이 값 = 다이~측정기 환산 거리이고, 그 거리가
# 설비에서 말이 되는 크기인지는 현장이 즉시 안다. 추정된 L 이 맞는지 확인할 외부
# 기준이 이것 하나뿐이라, 노이즈를 문 L 을 걸러내는 것은 이 줄이 유일하다.
COATING_LINE_SPEED_MPM=35
# 중간 산출물을 <리포트 출력 폴더>/dump/시각/ 에 CSV 로 남긴다(엑셀로 열어 확인용).
# 남기는 것: 제어값 변경 · 이벤트 · zone별 Δgap · 정착/오염 판정 · lag 정렬표 · 응답곡선.
#   python -m app.coating.report --dump      # 이번 실행만 켠다(.env 보다 우선)
# 검사용이지 캐시가 아니다 - 아무도 다시 읽지 않으므로 지워도 아무 일도 없다.
# 실데이터는 실행마다 수 MB 를 쌓으므로 기본은 꺼둔다.
COATING_DUMP_ENABLED=false
