# LLM backend switch: "ollama" | "internal"
LLM_BACKEND=ollama

# Ollama (LLM_BACKEND=ollama 일 때 사용)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma3n:e4b

# 사내 OpenAI 호환 API (LLM_BACKEND=internal 일 때 사용; base_url 은 /v1 포함 권장)
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_MODEL=
# 사내 SSL 검사(MITM/사설 CA) 환경:
#  (권장) 사내 루트 CA .pem 경로를 지정하면 검증을 유지한 채 연결됨
INTERNAL_LLM_CA_BUNDLE=
#  (비보안 우회) 위 CA 가 없을 때만 false 로 — SSL 검증을 끔(MITM 위험)
INTERNAL_LLM_VERIFY_SSL=true

# 사내 프록시 우회: 내부 LLM 이 회사 프록시를 거치면 안 될 때 true 로 (HTTP(S)_PROXY 를 비움)
BYPASS_PROXY=false

APP_DB_PATH=./app.db
CORS_ORIGINS=http://localhost:5173
