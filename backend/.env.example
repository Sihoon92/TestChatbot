# LLM backend switch: "ollama" | "internal"
LLM_BACKEND=ollama

# Ollama (LLM_BACKEND=ollama 일 때 사용)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma3n:e4b

# 사내 OpenAI 호환 API (LLM_BACKEND=internal 일 때 사용; base_url 은 /v1 포함 권장)
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_MODEL=
# 사내 SSL 검사(MITM/사설 CA) 환경:
#  (권장) 사내 루트 CA .pem 경로를 지정하면 검증을 유지한 채 연결됨
INTERNAL_LLM_CA_BUNDLE=
#  (비보안 우회) SSL 검증을 끔(MITM 위험) — 기본값. CA 번들을 구할 수 있으면 위에 지정하고 true 로 바꾸는 걸 권장
INTERNAL_LLM_VERIFY_SSL=false

# 사내 프록시 우회: LLM_BACKEND=internal 이면 자동으로 우회됨(HTTP(S)_PROXY 를 비움).
# ollama 백엔드에서도 프록시를 우회하고 싶을 때만 true 로 설정.
BYPASS_PROXY=false

APP_DB_PATH=./app.db
CORS_ORIGINS=http://localhost:5173

# LLM 디버그 로깅: LLM 호출마다 입력/출력을 사람이 읽기 좋은 텍스트 블록으로 파일에 남긴다.
DEBUG_LOG_ENABLED=true
DEBUG_LOG_PATH=./logs/llm_calls.log
DEBUG_LOG_MAX_BYTES=5000000
DEBUG_LOG_BACKUP_COUNT=5
# 진단용: 콜백 발화/파일 생성/쓰기 과정을 콘솔에 추적 출력(로그가 안 남을 때만 true).
DEBUG_LOG_VERBOSE=false
