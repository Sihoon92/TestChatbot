# LLM backend switch: "ollama" | "internal"
LLM_BACKEND=ollama

# Ollama (LLM_BACKEND=ollama 일 때 사용)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma3n:e4b
# 컨텍스트 창(토큰). Ollama 런타임 기본은 4096 이고, 모델이 131k 를 지원해도
# 그 값으로 서빙된다. 넘치면 에러 없이 앞부분이 잘리는데 거기 도구 정의가
# 있으면 모델이 도구를 전혀 못 부른다(빈 응답). 수집 에이전트는 도구 6종
# 스키마만으로 4천 자를 넘긴다. 문서가 크거나 도구가 늘면 더 올린다.
OLLAMA_NUM_CTX=16384

# 사내 OpenAI 호환 API (LLM_BACKEND=internal 일 때 사용; base_url 은 /v1 포함 권장)
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_MODEL=
# 사내 SSL 검사(MITM/사설 CA) 환경:
#  (권장) 사내 루트 CA .pem 경로를 지정하면 검증을 유지한 채 연결됨
INTERNAL_LLM_CA_BUNDLE=
#  (비보안 우회) SSL 검증을 끔(MITM 위험) — 기본값. CA 번들을 구할 수 있으면 위에 지정하고 true 로 바꾸는 걸 권장
INTERNAL_LLM_VERIFY_SSL=false

# 사내 프록시 우회: LLM_BACKEND=internal 이면 자동으로 우회됨(HTTP(S)_PROXY 를 비움).
# ollama 백엔드에서도 프록시를 우회하고 싶을 때만 true 로 설정.
BYPASS_PROXY=false

APP_DB_PATH=./app.db
CORS_ORIGINS=http://localhost:5173

# 개발 실행(dev.py) 백엔드 포트. 8000 이 이미 사용 중일 때만 바꾼다(예: 8001).
# dev.py 와 프론트 vite 프록시가 이 값을 함께 따라가므로 여기만 바꾸면 된다.
BACKEND_PORT=8000

# LLM 디버그 로깅: LLM 호출마다 입력/출력을 사람이 읽기 좋은 텍스트 블록으로 파일에 남긴다.
DEBUG_LOG_ENABLED=true
DEBUG_LOG_PATH=./logs/llm_calls.log
DEBUG_LOG_MAX_BYTES=5000000
DEBUG_LOG_BACKUP_COUNT=5
# 진단용: 콜백 발화/파일 생성/쓰기 과정을 콘솔에 추적 출력(로그가 안 남을 때만 true).
DEBUG_LOG_VERBOSE=false

# ── 금형 데이터 수집 ──────────────────────────────────────────────
# 부서가 엑셀을 올리는 루트(상대경로는 backend/ 기준)
INGEST_ROOT=./data/uploads
# 폴더명:소스종류 쌍. 폴더 이름이 바뀌면 여기만 고친다.
INGEST_STAGE_DIRS=MES:mes,IQC:iqc,PQC:pqc,설계:design,설치:install,AI복검:ai_recheck
# 채팅용 app.db 와 반드시 다른 파일이어야 한다(SQLite 쓰기 락 경합 회피)
MOLDS_DB_PATH=./molds.db
MASTER_XLSX_PATH=./data/관리자/금형현황.xlsx
# 0 = 자동 폴링 끔(수동 트리거만)
INGEST_POLL_SECONDS=0
